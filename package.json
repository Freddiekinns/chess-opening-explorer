{
  "name": "chess-trainer",
  "version": "1.0.0",
  "description": "A comprehensive chess opening trainer with AI-powered features",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=packages/api",
    "dev:web": "npm run dev --workspace=packages/web",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=packages/api",
    "build:web": "npm run build --workspace=packages/web",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "start:api": "npm run start --workspace=packages/api",
    "start:web": "npm run start --workspace=packages/web",
    "install:all": "npm install && npm install --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "vercel:prepare": "node scripts/prepare-vercel-data.js",
    "build:vercel": "npm run vercel:prepare && node scripts/generate-seo-lookup.js && node scripts/generate-sitemaps.js && npm run build:web",
    "seo:lookup": "node scripts/generate-seo-lookup.js",
    "seo:sitemaps": "node scripts/generate-sitemaps.js",
    "eco:import": "node packages/api/src/scripts/download-eco-data.js",
    "enrich": "node ./tools/llm-enrichment/enrich_openings_llm.js",
    "pipeline": "node tools/video-pipeline/index.js",
    "pipeline:full": "node tools/video-pipeline/index.js --mode=full",
    "pipeline:rematch": "node tools/video-pipeline/index.js --mode=rematch",
    "pipeline:complete": "node tools/video-pipeline/run-complete-pipeline.js",
    "pipeline:discover": "node tools/video-pipeline/1-discover-videos-rss.js",
    "pipeline:prefilter": "node tools/video-pipeline/2-prefilter-candidates.js",
    "pipeline:enrich": "node tools/video-pipeline/3-enrich-videos.js",
    "pipeline:match": "node tools/video-pipeline/video-matcher.js",
    "course:discover": "node tools/course-discovery/discover-popular.js",
    "course:import": "node tools/course-discovery/add-studies.js",
    "course:rematch": "node tools/course-discovery/add-studies.js --fromCache",
    "sample:generate": "npm run build --workspace=packages/shared && node tools/sample-reports/generate-sample-reports.js",
    "test": "jest",
    "eco:fix-analysis": "node scripts/fix-analysis-json.js",
    "eco:validate-analysis": "node scripts/validate-analysis-json.js",
    "test:backend": "jest",
    "test:frontend": "npm run test --workspace=packages/web",
    "test:all": "npm run test:backend && npm run test:frontend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:setup": "jest tests/setup",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": "prettier --write",
    "packages/**/*.{js,jsx,ts,tsx}": "eslint"
  },
  "keywords": [
    "chess",
    "openings",
    "training",
    "ai",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.21.5",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.2.5",
    "supertest": "^7.1.3",
    "yargs": "^18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "packages/api/**/*.js",
      "!**/node_modules/**",
      "!**/tests/**",
      "!packages/web/**",
      "!packages/shared/**/*.{ts,d.ts}",
      "!scripts/**",
      "!prompts/**",
      "!packages/api/.eslintrc.js",
      "!packages/api/src/server.js",
      "!packages/api/src/config/**/*.js",
      "!packages/api/src/routes/openings.routes.js",
      "!packages/api/src/services/chesscom-games-service.js",
      "!packages/api/src/services/database-service.js",
      "!packages/api/src/services/eco-service.js",
      "!packages/api/src/services/llm-service.js",
      "!packages/api/src/services/opening-data-service.js",
      "!packages/api/src/services/personal-games-service.js",
      "!packages/api/src/services/search-service.js",
      "!packages/api/src/services/search/QueryIntentParser.js",
      "!packages/api/src/services/search/SearchConstants.js",
      "!packages/api/src/services/video-processor.js",
      "!packages/api/src/services/youtube-service.js",
      "!packages/api/src/utils/testUtils.js",
      "!packages/api/download-eco.js",
      "!api/**"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js",
      "<rootDir>/tools/**/tests/**/*.test.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "setupFilesAfterEnv": [
      "./tests/setup/global-setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/packages/.*/tests/",
      "tests/unit/.*ui.*\\.test\\.",
      "tests/unit/.*design.*\\.test\\.",
      "tests/unit/.*phase.*\\.test\\."
    ]
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.10.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@xmldom/xmldom": "^0.9.12",
    "dotenv": "^17.2.0",
    "google-auth-library": "^10.1.0",
    "googleapis": "^153.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sqlite3": "^5.1.7"
  }
}
