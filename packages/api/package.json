{
  "name": "@chess-trainer/api",
  "version": "1.0.0",
  "description": "Chess Trainer API - Backend server for chess opening training",
  "main": "src/server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "echo 'No build step required for API'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --testNamePattern='integration'",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "eco:import": "node src/services/eco-service.js",
    "eco:update": "node src/services/eco-service.js",
    "data:import": "node ../../tools/data/import-data.js",
    "data:export": "node ../../tools/data/export-data.js",
    "data:validate": "node ../../tools/data/validate-data.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fuse.js": "^7.5.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
